# twilio-connector config. Copy to .env and fill in. See
# twilio-connector/README.md for what each key does.

TWILIO_CONNECTOR_PORT=8789

# hermes-core's phone WSS endpoint. Shared bearer, same value as hermes-core's
# PHONE_AGENT_CONTROL_TOKEN.
HERMES_WS_URL=ws://localhost:8787/phone
PHONE_AGENT_CONTROL_TOKEN=

# This connector's device id — must be unique across every connected device
# (a phone-connector handset, another twilio-connector, etc).
DEVICE_ID=twilio-main

# Twilio account (Console > Account > API keys & tokens).
# Fill values in directly here — never in chat or a shell command — and rotate
# immediately in the Twilio console if a token was ever pasted anywhere else.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# Public HTTPS base Twilio can reach (Cloudflare Tunnel hostname) — used to build
# the <Stream> and outbound-answer webhook URLs, and configured as the number's
# Voice webhook in the Twilio console.
PUBLIC_BASE_URL=

# Gemini Live — same key phone-connector uses (repo-root .env: gemini_key).
GEMINI_API_KEY=
