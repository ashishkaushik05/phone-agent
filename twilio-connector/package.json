{
  "name": "twilio-connector",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Bridges a Twilio number's voice calls to hermes-core, speaking the same phone-connector protocol a physical Android device does.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "alawmulaw": "^6.0.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
