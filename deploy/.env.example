# VPS deployment secrets — copy to deploy/.env on the VPS itself (git-ignored, never
# committed). Generate real random values for the two secrets below; do not reuse
# "smoke-token" or any dev default in production.

POSTGRES_PASSWORD=
PHONE_AGENT_CONTROL_TOKEN=
MODEL_API_KEY=
DIRECTOR_MODEL=muse-spark-1.3-contributor
OWNER_WHATSAPP=

# twilio-connector — see ../twilio-connector/README.md
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Public HTTPS hostname (Cloudflare Tunnel) Twilio reaches this connector at, no trailing slash.
TWILIO_PUBLIC_BASE_URL=
GEMINI_API_KEY=
