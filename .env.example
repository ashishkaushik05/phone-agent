# phone-agent config — one repo-root .env, shared by phone-connector/build.sh
# and hermes-core. Copy relevant lines into your real .env (git-ignored).
# Only gemini_key is required.

# ── Required ─────────────────────────────────────────────────────────────────
# Gemini Live API key (ai.google.dev / Google AI Studio). Baked into the
# connector APK by phone-connector/build.sh; hermes-core also reads it for the
# smoke test (smoke/mock-phone.mjs opens a real Gemini Live session).
gemini_key=

# ── phone-connector → hermes-core link (baked into the APK by build.sh) ───────
# All three unset → the link is disabled and inbound calls run on the connector's
# baked-in fallback persona (not an error).
hermes_ws_url=ws://localhost:8787/phone
hermes_device_id=ginkgo-1
hermes_token=smoke-token
# Max call duration before the connector's watchdog hangs up. Default 600000.
max_call_ms=600000

# ── hermes-core (see hermes-core/.env.example for the full list) ──────────────
# PHONE_AGENT_CONTROL_TOKEN  bearer for WSS /phone, WSS /dashboard, mutating REST
# DATABASE_URL               Postgres; unset → in-process PGlite (dev/tests)
# REDIS_URL                  optional; unset → single-instance local bus
# MODEL_API_KEY              Meta Model API key (dev.meta.ai) → director on Muse
#                            Spark; unset → deterministic `rules` brain

# ── legacy on-device Gemini tools (retired prototype) ───────────────────────
# phone-connector removed all three (it declares only a local end_call), so
# these are inert unless the old prototype is revived. See docs/tool-integrations.md.
# sheets_service_account_email=
# sheets_service_account_private_key=
# sheets_spreadsheet_id=
# calendar_service_account_email=
# calendar_service_account_private_key=
# hermes_api_url=
# hermes_api_token=
