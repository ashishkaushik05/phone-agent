# hermes-core config. The repo-root .env is also read (for gemini_key).
# Copy to .env and fill in. See README.md for what each key does.

HERMES_PORT=8787

# Bearer token the phone-connector (and REST callers) must present.
PHONE_AGENT_CONTROL_TOKEN=smoke-token

# Director brain: "rules" (deterministic, no external calls) or "muse" (Meta Model API).
# Defaults to "muse" when MODEL_API_KEY is set, else "rules".
DIRECTOR_MODE=
# Meta Model API key (dev.meta.ai) — serves Muse Spark / Muse Code, OpenAI-SDK compatible.
MODEL_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
DIRECTOR_MODEL=muse-spark-1.2
# Owner's real phone, E.164 — the director WhatsApps a caller's message here.
OWNER_WHATSAPP=

# Postgres connection string; empty → in-process PGlite (dev/tests/smoke).
DATABASE_URL=
# Redis connection string; empty → in-process event bus (single instance).
REDIS_URL=
