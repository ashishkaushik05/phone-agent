# hermes-mcp config. The repo-root .env is also read (for PHONE_AGENT_CONTROL_TOKEN, shared
# with hermes-core). Copy to .env and fill in, or just rely on the repo-root .env — see README.md.

HERMES_MCP_PORT=8788

# hermes-core's REST base URL — this adapter's only way of reaching hermes-core.
HERMES_CORE_URL=http://localhost:8787

# Shared bearer, same value as hermes-core's PHONE_AGENT_CONTROL_TOKEN: sent to hermes-core,
# and required from any MCP client calling this server. One secret, one trust domain.
PHONE_AGENT_CONTROL_TOKEN=smoke-token
